# Copy to /etc/aircast.env (chmod 600) and fill in.

# Your location (decimal degrees). Example: New York City.
AQI_LAT=40.7128
AQI_LON=-74.0060
# Label shown in alert titles ("...  ||  ~New York, NY"); defaults to the nearest monitor's name.
AQI_PLACE=New York, NY
# Time zone for times in alerts (servers usually run on UTC).
TZ=America/New_York

# Alert when US AQI is expected to exceed this.
AQI_THRESHOLD=35
AQI_HORIZON_HOURS=12
# Check hourly when all is quiet, every 30 min when anything is brewing.
AQI_POLL_GOOD_MINUTES=60
AQI_POLL_BAD_MINUTES=30

# Free key from https://docs.airnowapi.org/ (strongly recommended: real monitor
# readings for bias correction and upwind smoke detection).
AIRNOW_API_KEY=

# ntfy running on the same droplet; publish over localhost.
NTFY_URL=http://127.0.0.1:2586
NTFY_TOPIC=aqi
NTFY_TOKEN=
# Large notification icon (PNG/JPEG URL the phone can fetch).
NTFY_ICON=https://ntfy.example.com/icons/aqi.png

AQI_DB=/var/lib/aircast/state.db

# Tuning (defaults shown)
# AQI_ALERT_PROB=0.5        alert when P(exceed) >= this in any hour of the horizon
# AQI_CLEAR_PROB=0.2        all-clear only when P(exceed) < this ...
# AQI_HYSTERESIS=5          ... and current AQI <= threshold - this
# AQI_REMIND_HOURS=6        repeat "above threshold now" this often (0 = never)
# AQI_TAU_HOURS=12          how fast observed bias fades with forecast lead
# AQI_SIGMA0=8              starting model error (AQI points); learned from data over time
# AQI_SIGMA_GROWTH=0.6      added uncertainty per forecast hour
# AQI_USE_WIND=1
# AQI_RING_KM=50            radius of model upwind ring
# AQI_WIND_WEIGHT=0.35      max pull toward model-upwind AQI
# AQI_UPWIND_KM=250         radius (~155 mi) for AirNow monitors used upwind
# AQI_WATCH_AQI=            upwind AQI that triggers a watch (default: AQI_THRESHOLD)
# AQI_WATCH_HOURS=24        how far ahead forecast winds are traced for the watch
# AQI_TRANSPORT=mixed       mixed = mean of 10 m and 850 hPa wind; surface = 10 m only
# AQI_SMOKE=1               NOAA HMS satellite smoke plumes (no key needed)
# AQI_SMOKE_CLEAR_HOURS=3   smoke level must stay lower this long before stepping down
# AQI_SMOKE_FAR_MI=200      outermost smoke alert radius (level 1)
# AQI_DILUTION_KM=400       upwind air's excess over local air halves every ~280 km (e-folding length)
# AQI_LEARN=1               apply learned per-lead-time bias from logged forecasts vs. observations
# AQI_LEARN_SHRINK=50       learned bias weight is n / (n + this): small until data builds up
# AQI_LOG_DAYS=60           how long forecasts are kept for learning and `aircast.py score`
# AQI_HMS_URL=              override the HMS shapefile URL (strftime pattern)
# AQI_OBS_WEIGHT=0.6        max pull toward observed-upwind AQI
# AQI_STAGNANT_MS=2         below this wind speed, add stagnation uncertainty
