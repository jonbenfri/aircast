[Unit]
Description=aircast air quality forecasting (pushes alerts via ntfy)
Wants=network-online.target
After=network-online.target ntfy.service

[Service]
Type=simple
User=aqi
EnvironmentFile=/etc/aircast.env
ExecStart=/opt/aircast/.venv/bin/python /opt/aircast/aircast.py run
Restart=always
RestartSec=30
# Kept to options that old systemd (e.g. 229 on Ubuntu 16.04) understands.
# /var/lib/aircast is created by hand (see README) since StateDirectory= needs systemd 235+.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
